<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.rain.zhixuelearning.mapper.LearningRecordMapper">
    <insert id="insert" parameterType="com.rain.zhixuelearning.entity.LearningRecords" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO learning_records
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="userId != null">user_id,</if>
            <if test="problemId != null">problem_id,</if>
            <if test="submissionId != null">submission_id,</if>
            <if test="status != null">status,</if>
            <if test="score != null">score,</if>
            <if test="timeSpentMs != null">time_spent_ms,</if>
            <if test="debugCount != null">debug_count,</if>
        </trim>
        VALUES
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="userId != null">#{userId},</if>
            <if test="problemId != null">#{problemId},</if>
            <if test="submissionId != null">#{submissionId},</if>
            <if test="status != null">#{status},</if>
            <if test="score != null">#{score},</if>
            <if test="timeSpentMs != null">#{timeSpentMs},</if>
            <if test="debugCount != null">#{debugCount},</if>
        </trim>
    </insert>
    <select id="selectList" parameterType="com.alibaba.fastjson2.JSONObject" resultType="com.rain.zhixuelearning.entity.LearningRecords">
        SELECT
        id,
        user_id ,
        problem_id ,
        submission_id,
        status,
        score,
        time_spent_ms,
        debug_count,
        attempts,
        first_solved_at,
        last_attempt_at,
        created_at,
        updated_at
        FROM learning_records
        WHERE 1=1
        <if test="userId != null">
            AND user_id = #{userId}
        </if>
        <if test="problemId != null">
            AND problem_id = #{problemId}
        </if>
        <if test="status != null and status != ''">
            AND status = #{status}
        </if>
        <if test="startDate != null and startDate != ''">
            AND DATE(created_at) &gt;= #{startDate}
        </if>
        <if test="endDate != null and endDate != ''">
            AND DATE(created_at) &lt;= #{endDate}
        </if>
        ORDER BY created_at DESC
    </select>
    <select id="count" parameterType="com.alibaba.fastjson2.JSONObject" resultType="java.lang.Long">
        SELECT COUNT(*)
        FROM learning_records
        WHERE 1=1
        <if test="userId != null">
            AND user_id = #{userId}
        </if>
        <if test="problemId != null">
            AND problem_id = #{problemId}
        </if>
        <if test="status != null and status != ''">
            AND status = #{status}
        </if>
        <if test="startDate != null and startDate != ''">
            AND DATE(created_at) &gt;= #{startDate}
        </if>
        <if test="endDate != null and endDate != ''">
            AND DATE(created_at) &lt;= #{endDate}
        </if>
    </select>
    <select id="selectById" resultType="com.rain.zhixuelearning.entity.LearningRecords">
        SELECT
            id,
            user_id ,
            problem_id ,
            submission_id,
            status,
            score,
            time_spent_ms,
            debug_count,
            attempts,
            first_solved_at,
            last_attempt_at,
            created_at,
            updated_at
        FROM learning_records
        WHERE id=#{id}
    </select>
</mapper>
