<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.rain.zhixueuser.mapper.UserMangementMapper">
    <update id="updateById" parameterType="com.rain.zhixueuser.entity.User">
        UPDATE users
        <set>
            <if test="realName != null">real_name = #{realName},</if>
            <if test="phone != null">phone = #{phone},</if>
            <if test="school != null">school = #{school},</if>
            <if test="major != null">major = #{major},</if>
            updated_at = CURRENT_TIMESTAMP
        </set>
        WHERE id = #{id}
    </update>
    <select id="selectById" resultType="com.rain.zhixueuser.entity.User">
        SELECT id,username,email,phone,real_name,school,major,learning_level,experience_points,created_at,updated_at
        FROM users
        WHERE id=#{id}
    </select>
</mapper>
