<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.rain.zhixueai.dispatcher.mapper.ModelInstanceMapper">
    
    <resultMap id="ModelInstanceResultMap" type="com.rain.zhixueai.dispatcher.entity.ModelInstance">
        <id property="id" column="id"/>
        <result property="groupId" column="group_id"/>
        <result property="name" column="name"/>
        <result property="apiEndpoint" column="api_endpoint"/>
        <result property="modelName" column="model_name"/>
        <result property="apiKey" column="api_key"/>
        <result property="weight" column="weight"/>
        <result property="maxConcurrent" column="max_concurrent"/>
        <result property="currentConnections" column="current_connections"/>
        <result property="status" column="status" 
                typeHandler="com.rain.zhixueai.dispatcher.mapper.handler.InstanceStatusTypeHandler"/>
        <result property="healthCheckEndpoint" column="health_check_endpoint"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <update id="incrementConnections">
        UPDATE model_instance SET current_connections = current_connections + 1 WHERE id = #{id}
    </update>

    <update id="decrementConnections">
        UPDATE model_instance SET current_connections = GREATEST(current_connections - 1, 0) WHERE id = #{id}
    </update>

</mapper>
