<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.rain.zhixueai.mapper.rag.RagChunkMapper">
    
    <resultMap id="RagChunkResultMap" type="com.rain.zhixueai.entity.rag.RagChunk">
        <id property="id" column="id"/>
        <result property="documentId" column="document_id"/>
        <result property="knowledgeBaseId" column="knowledge_base_id"/>
        <result property="chunkIndex" column="chunk_index"/>
        <result property="content" column="content"/>
        <result property="vectorId" column="vector_id"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>
    
    <select id="findByDocumentId" resultMap="RagChunkResultMap">
        SELECT * FROM rag_chunk WHERE document_id = #{documentId} ORDER BY chunk_index ASC
    </select>
    
    <select id="findByKnowledgeBaseId" resultMap="RagChunkResultMap">
        SELECT * FROM rag_chunk WHERE knowledge_base_id = #{knowledgeBaseId} ORDER BY document_id, chunk_index ASC
    </select>
    
    <select id="findById" resultMap="RagChunkResultMap">
        SELECT * FROM rag_chunk WHERE id = #{id}
    </select>
    
    <select id="findByVectorId" resultMap="RagChunkResultMap">
        SELECT * FROM rag_chunk WHERE vector_id = #{vectorId}
    </select>
    
    <select id="countByDocumentId" resultType="int">
        SELECT COUNT(*) FROM rag_chunk WHERE document_id = #{documentId}
    </select>
    
    <select id="countByKnowledgeBaseId" resultType="int">
        SELECT COUNT(*) FROM rag_chunk WHERE knowledge_base_id = #{knowledgeBaseId}
    </select>
    
    <insert id="insert" parameterType="com.rain.zhixueai.entity.rag.RagChunk" 
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO rag_chunk (
            document_id, knowledge_base_id, chunk_index, content, 
            vector_id, created_at
        ) VALUES (
            #{documentId}, #{knowledgeBaseId}, #{chunkIndex}, #{content},
            #{vectorId}, NOW()
        )
    </insert>
    
    <insert id="batchInsert" parameterType="java.util.List">
        INSERT INTO rag_chunk (
            document_id, knowledge_base_id, chunk_index, content, 
            vector_id, created_at
        ) VALUES
        <foreach collection="chunks" item="chunk" separator=",">
            (#{chunk.documentId}, #{chunk.knowledgeBaseId}, #{chunk.chunkIndex}, #{chunk.content},
             #{chunk.vectorId}, NOW())
        </foreach>
    </insert>
    
    <delete id="delete">
        DELETE FROM rag_chunk WHERE id = #{id}
    </delete>
    
    <delete id="deleteByDocumentId">
        DELETE FROM rag_chunk WHERE document_id = #{documentId}
    </delete>
    
    <delete id="deleteByKnowledgeBaseId">
        DELETE FROM rag_chunk WHERE knowledge_base_id = #{knowledgeBaseId}
    </delete>
    
    <update id="updateVectorId">
        UPDATE rag_chunk SET vector_id = #{vectorId} WHERE id = #{id}
    </update>
</mapper>
