FROM maven:3.9-eclipse-temurin-17-alpine AS builder

WORKDIR /build

COPY pom.xml .
COPY zhixue-common ./zhixue-common
COPY zhixue-user ./zhixue-user
COPY zhixue-problem ./zhixue-problem
COPY zhixue-learning ./zhixue-learning
COPY zhixue-ai ./zhixue-ai
COPY zhixue-admin ./zhixue-admin
COPY zhixue-getaway ./zhixue-getaway

RUN mvn clean package -DskipTests -pl zhixue-common,zhixue-ai -am

FROM eclipse-temurin:17-jre-alpine

WORKDIR /app

RUN apk add --no-cache tzdata curl

COPY --from=builder /build/zhixue-ai/target/*.jar app.jar

EXPOSE 8086

ENV TZ=Asia/Shanghai
ENV JAVA_OPTS="-Xms512m -Xmx1024m"

ENTRYPOINT ["sh", "-c", "java $JAVA_OPTS -Djava.security.egd=file:/dev/./urandom -jar /app/app.jar"]
