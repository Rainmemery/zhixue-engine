<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.rain.zhixueproblem.mapper.ZhixueProblemTagRelMapper">

    <resultMap id="BaseResultMap" type="com.rain.zhixueproblem.entity.ZhixueProblemTagRel">
        <id column="id" property="id"/>
        <result column="problem_id" property="problemId"/>
        <result column="tag_id" property="tagId"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, problem_id, tag_id
    </sql>

    <insert id="insert" parameterType="com.rain.zhixueproblem.entity.ZhixueProblemTagRel" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO zhixue_problem_tag_rel (problem_id, tag_id)
        VALUES (#{problemId}, #{tagId})
    </insert>

    <delete id="deleteByProblemId">
        DELETE FROM zhixue_problem_tag_rel WHERE problem_id = #{problemId}
    </delete>

    <delete id="deleteByProblemIdAndTagId">
        DELETE FROM zhixue_problem_tag_rel WHERE problem_id = #{problemId} AND tag_id = #{tagId}
    </delete>

    <select id="selectByProblemId" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM zhixue_problem_tag_rel
        WHERE problem_id = #{problemId}
    </select>

    <select id="selectByTagId" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM zhixue_problem_tag_rel
        WHERE tag_id = #{tagId}
    </select>

    <insert id="batchInsert" parameterType="java.util.List">
        INSERT INTO zhixue_problem_tag_rel (problem_id, tag_id)
        VALUES
        <foreach collection="list" item="item" separator=",">
            (#{item.problemId}, #{item.tagId})
        </foreach>
    </insert>

</mapper>
